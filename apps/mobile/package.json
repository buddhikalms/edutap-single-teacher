{
  "name": "edutap-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android.ps1",
