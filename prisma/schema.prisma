  ABSENT
  LATE
  EXCUSED
}

enum AttendanceSessionStatus {
  ACTIVE
  ENDED
}

enum AttendanceSource {
  MANUAL
  QR
  NFC
  BULK
}

enum ClassType {
  INHOUSE
  ONLINE
  HYBRID
}

enum FreePeriodType {
  NONE
  FIRST_WEEK
  SECOND_WEEK
  FIRST_MONTH
  CUSTOM_DAYS
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
  LOCKED
  DELETED
}

enum EnrollmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CONVERTED
}

enum AttendanceSessionType {
  INHOUSE
  ONLINE
  HYBRID
}

enum AttendanceSearchMethod {
  NFC
  QR
  MANUAL_ID
  MANUAL_SEARCH
}

enum PaymentStatus {
