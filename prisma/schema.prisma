generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  INSTITUTE_ADMIN
  BRANCH_ADMIN
  TEACHER
  STAFF
  STUDENT
  PARENT
}

enum StudentStatus {
  ACTIVE
  PAUSED
  GRADUATED
  ARCHIVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceSessionStatus {
  ACTIVE
  ENDED
}

enum AttendanceSource {
  MANUAL
  QR
  NFC
  BULK
}

enum ClassType {
  INHOUSE
  ONLINE
  HYBRID
}

enum FreePeriodType {
  NONE
  FIRST_WEEK
  SECOND_WEEK
  FIRST_MONTH
  CUSTOM_DAYS
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
  LOCKED
  DELETED
}

enum AttendanceSessionType {
  INHOUSE
  ONLINE
  HYBRID
}

enum AttendanceSearchMethod {
  NFC
  QR
  MANUAL_ID
  MANUAL_SEARCH
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
}

enum PaymentType {
  MONTHLY_FEE
  ADMISSION_FEE
  EXAM_FEE
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
}

enum NoticeAudience {
  INSTITUTE
  CLASS
  STUDENTS
}

enum NotificationType {
  NOTICE
  PAYMENT_DUE
  ABSENT_ALERT
  CLASS_NOTICE
  RECEIPT
}

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

enum SubscriptionPlan {
  TEACHER
  SMALL_INSTITUTE
  PREMIUM_INSTITUTE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

enum HomeworkStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum HomeworkSubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  MISSING
  REVIEWED
}

enum HomeworkReviewStatus {
  ACCEPTED
  REJECTED
  RESUBMIT
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum QuizQuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_MARKED
  REVIEWED
}

enum NotificationReadStatus {
  UNREAD
  READ
}

enum CourseMaterialType {
  LINK
  FILE
  VIDEO
  NOTE
}

enum LiveClassProvider {
  GOOGLE_MEET
  ZOOM
  YOUTUBE_LIVE
  JITSI
  LIVEKIT
  OTHER
}

enum LiveClassMeetingProvider {
  ZOOM_AUTO
  GOOGLE_MEET_AUTO
  EXTERNAL_ZOOM
  EXTERNAL_GOOGLE_MEET
  YOUTUBE_LIVE
  OTHER_LINK
}

enum LiveClassAccessType {
  FREE
  PAID
}

enum LiveClassStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum LiveClassAttendanceStatus {
  JOINED
  LEFT
}

enum IntegrationProvider {
  ZOOM
  GOOGLE
}

model Institute {
  id                   String                 @id @default(cuid())
  name                 String
  slug                 String                 @unique
  email                String
  phone                String?
  address              String?
  logoUrl              String?
  active               Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  branches             Branch[]
  grades               Grade[]
  users                User[]
  students             Student[]
  parents              Parent[]
  teachers             Teacher[]
  courses              Course[]
  classGroups          ClassGroup[]
  payments             Payment[]
  receipts             Receipt[]
  auditLogs            AttendanceAuditLog[]
  notices              Notice[]
  notifications        NotificationLog[]
  settings             InstituteSettings?
  subscription         InstituteSubscription?
  homework             Homework[]
  homeworkSubmissions  HomeworkSubmission[]
  quizzes              Quiz[]
  quizAttempts         QuizAttempt[]
  notificationsV2      Notification[]
  courseMaterials      CourseMaterial[]
  studentDevices       StudentDevice[]
  liveClasses          LiveClass[]
  liveClassAttendances LiveClassAttendance[]
  liveClassRecordings  LiveClassRecording[]
  integrationAccounts  IntegrationAccount[]
  providerCredentials  ProviderCredential[]
}

model InstituteSettings {
  id                      String    @id @default(cuid())
  instituteId             String    @unique
  receiptPrefix           String    @default("RCT")
  receiptFooter           String?   @db.Text
  paymentDueDay           Int       @default(10)
  attendanceLateAfterMins Int       @default(15)
  attendanceAutoAbsent    Boolean   @default(false)
  currency                String    @default("USD")
  themeColor              String    @default("#0f766e")
  logoPlaceholder         String?
  branchSettings          Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  institute               Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
}

model InstituteSubscription {
  id               String             @id @default(cuid())
  instituteId      String             @unique
  plan             SubscriptionPlan   @default(SMALL_INSTITUTE)
  status           SubscriptionStatus @default(TRIAL)
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime?
  monthlyPrice     Decimal            @default(79) @db.Decimal(10, 2)
  studentLimit     Int
  teacherLimit     Int
  branchLimit      Int
  smsCredits       Int
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  institute        Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([plan])
  @@index([status])
}

model Branch {
  id          String       @id @default(cuid())
  name        String
  code        String
  location    String?
  address     String?
  phone       String?
  isActive    Boolean      @default(true)
  instituteId String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  institute   Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  users       User[]
  students    Student[]
  teachers    Teacher[]
  classGroups ClassGroup[]
  attendanceSessions AttendanceSession[]

  @@unique([instituteId, code])
  @@index([instituteId])
}

model Grade {
  id          String       @id @default(cuid())
  instituteId String
  name        String
  order       Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  institute   Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  courses     Course[]
  classGroups ClassGroup[]

  @@unique([instituteId, name])
  @@index([instituteId, order])
}

model User {
  id                     String            @id @default(cuid())
  name                   String
  email                  String            @unique
  passwordHash           String
  role                   UserRole          @default(STAFF)
  image                  String?
  emailVerified          DateTime?
  instituteId            String?
  branchId               String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  institute              Institute?        @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  branch                 Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  teacher                Teacher?
  parent                 Parent?
  student                Student?
  mobileTokens           MobileAuthToken[]
  noticesCreated         Notice[]
  notifications          NotificationLog[]
  homeworkCreated        Homework[]        @relation("HomeworkCreatedBy")
  quizzesCreated         Quiz[]            @relation("QuizCreatedBy")
  courseMaterialsCreated CourseMaterial[]  @relation("CourseMaterialCreatedBy")
  liveClassesCreated     LiveClass[]       @relation("LiveClassCreatedBy")

  @@index([instituteId])
  @@index([branchId])
}

model MobileAuthToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Student {
  id                   String                @id @default(cuid())
  admissionNo          String
  firstName            String
  lastName             String
  email                String?
  phone                String?
  dateOfBirth          DateTime?
  status               StudentStatus         @default(ACTIVE)
  avatarUrl            String?
  nfcUid               String?
  qrCode               String?
  attendanceToken      String?               @default(cuid())
  userId               String?               @unique
  instituteId          String
  branchId             String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  institute            Institute             @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch               Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  parents              Parent[]
  enrollments          Enrollment[]
  attendance           AttendanceRecord[]
  payments             Payment[]
  auditLogs            AttendanceAuditLog[]
  noticeRecipients     NoticeRecipient[]
  notifications        NotificationLog[]
  homeworkSubmissions  HomeworkSubmission[]
  quizAttempts         QuizAttempt[]
  notificationsV2      Notification[]
  devices              StudentDevice[]
  liveClassAttendances LiveClassAttendance[]

  @@unique([instituteId, admissionNo])
  @@index([instituteId, nfcUid])
  @@index([instituteId, qrCode])
  @@index([attendanceToken])
  @@index([branchId])
}

model Parent {
  id               String            @id @default(cuid())
  name             String
  email            String?
  phone            String
  occupation       String?
  userId           String?           @unique
  instituteId      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  institute        Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students         Student[]
  noticeRecipients NoticeRecipient[]
  notifications    NotificationLog[]

  @@index([instituteId])
}

model Teacher {
  id          String       @id @default(cuid())
  name        String
  email       String
  phone       String?
  specialty   String?
  userId      String?      @unique
  instituteId String
  branchId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  institute   Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  classGroups ClassGroup[]
  liveClasses LiveClass[]

  @@unique([instituteId, email])
  @@index([branchId])
}

model Course {
  id             String               @id @default(cuid())
  name           String
  code           String
  subject        String?
  grade          String?
  gradeId        String?
  description    String?
  fee            Decimal              @db.Decimal(10, 2)
  instituteId    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  institute      Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  gradeLevel     Grade?               @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  classGroups    ClassGroup[]
  homework       Homework[]
  quizzes        Quiz[]
  materials      CourseMaterial[]
  liveClasses    LiveClass[]
  liveRecordings LiveClassRecording[]

  @@unique([instituteId, code])
  @@index([instituteId])
  @@index([gradeId])
}

model ClassGroup {
  id                 String               @id @default(cuid())
  name               String
  code               String
  schedule           String
  room               String?
  capacity           Int                  @default(30)
  instituteId        String
  branchId           String
  gradeId            String?
  courseId           String
  teacherId          String?
  classType          ClassType            @default(INHOUSE)
  monthlyFee         Decimal?             @db.Decimal(10, 2)
  defaultFreePeriodType FreePeriodType    @default(NONE)
  defaultFreeDays    Int                  @default(0)
  defaultPaymentDueDay Int                @default(10)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  institute          Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch             Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  gradeLevel         Grade?               @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  course             Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher            Teacher?             @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments        Enrollment[]
  attendanceSessions AttendanceSession[]
  payments           Payment[]
  notices            Notice[]
  homework           Homework[]
  quizzes            Quiz[]
  materials          CourseMaterial[]
  liveClasses        LiveClass[]
  liveRecordings     LiveClassRecording[]

  @@unique([instituteId, code])
  @@index([branchId])
  @@index([gradeId])
  @@index([courseId])
}

model Enrollment {
  id           String     @id @default(cuid())
  studentId    String
  classGroupId String
  enrolledAt   DateTime   @default(now())
  active       Boolean    @default(true)
  status       EnrollmentStatus @default(ACTIVE)
  paymentStartDate DateTime?
  freePeriodType FreePeriodType @default(NONE)
  freeDays     Int        @default(0)
  monthlyFeeOverride Decimal? @db.Decimal(10, 2)
  discount     Decimal    @default(0) @db.Decimal(10, 2)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  @@unique([studentId, classGroupId])
  @@index([classGroupId])
  @@index([status])
  @@index([paymentStartDate])
}

model AttendanceSession {
  id           String                  @id @default(cuid())
  branchId     String?
  classGroupId String
  sessionDate  DateTime
  sessionType  AttendanceSessionType   @default(INHOUSE)
  startedById  String?
  startsAt     DateTime?
  endsAt       DateTime?
  status       AttendanceSessionStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @default(now()) @updatedAt
  branch        Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  classGroup   ClassGroup              @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  records      AttendanceRecord[]
  auditLogs    AttendanceAuditLog[]

  @@unique([classGroupId, sessionDate])
  @@index([sessionDate])
  @@index([branchId])
  @@index([classGroupId, status])
}

model AttendanceRecord {
  id        String               @id @default(cuid())
  sessionId String
  studentId String
  status    AttendanceStatus     @default(PRESENT)
  source    AttendanceSource     @default(MANUAL)
  searchMethod AttendanceSearchMethod?
  markedById String?
  markedAt  DateTime             @default(now())
  notes     String?
  session   AttendanceSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  auditLogs AttendanceAuditLog[]

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model AttendanceAuditLog {
  id          String            @id @default(cuid())
  instituteId String
  sessionId   String
  studentId   String?
  recordId    String?
  source      AttendanceSource
  status      AttendanceStatus?
  success     Boolean
  message     String
  metadata    Json?
  createdAt   DateTime          @default(now())
  institute   Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student     Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  record      AttendanceRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@index([instituteId, createdAt])
  @@index([sessionId])
  @@index([studentId])
}

model Payment {
  id           String         @id @default(cuid())
  invoiceNo    String
  type         PaymentType    @default(MONTHLY_FEE)
  month        String?
  amount       Decimal        @db.Decimal(10, 2)
  discount     Decimal        @default(0) @db.Decimal(10, 2)
  paidAmount   Decimal        @default(0) @db.Decimal(10, 2)
  balance      Decimal        @default(0) @db.Decimal(10, 2)
  dueDate      DateTime
  paidAt       DateTime?
  status       PaymentStatus  @default(PENDING)
  method       PaymentMethod?
  note         String?
  receivedBy   String?
  instituteId  String
  studentId    String
  classGroupId String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  institute    Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroup   ClassGroup?    @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  receipts     Receipt[]

  @@unique([instituteId, invoiceNo])
  @@index([studentId])
  @@index([classGroupId])
  @@index([instituteId, month])
  @@index([instituteId, status])
}

model Receipt {
  id            String            @id @default(cuid())
  receiptNo     String
  issuedAt      DateTime          @default(now())
  amount        Decimal           @db.Decimal(10, 2)
  receivedBy    String?
  paymentId     String
  instituteId   String
  payment       Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  institute     Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  notifications NotificationLog[]

  @@unique([instituteId, receiptNo])
  @@index([instituteId])
  @@index([paymentId])
}

model Notice {
  id            String            @id @default(cuid())
  title         String
  body          String            @db.Text
  audience      NoticeAudience    @default(INSTITUTE)
  type          NotificationType  @default(NOTICE)
  instituteId   String
  classGroupId  String?
  createdById   String?
  publishAt     DateTime          @default(now())
  expiresAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  institute     Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  classGroup    ClassGroup?       @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  createdBy     User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  recipients    NoticeRecipient[]
  notifications NotificationLog[]

  @@index([instituteId, createdAt])
  @@index([classGroupId])
}

model NoticeRecipient {
  id        String   @id @default(cuid())
  noticeId  String
  studentId String
  parentId  String?
  createdAt DateTime @default(now())
  notice    Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent    Parent?  @relation(fields: [parentId], references: [id], onDelete: SetNull)

  @@unique([noticeId, studentId])
  @@index([studentId])
  @@index([parentId])
}

model NotificationLog {
  id          String              @id @default(cuid())
  instituteId String
  noticeId    String?
  userId      String?
  studentId   String?
  parentId    String?
  receiptId   String?
  type        NotificationType
  channel     NotificationChannel @default(IN_APP)
  status      NotificationStatus  @default(QUEUED)
  title       String
  message     String              @db.Text
  target      String?
  provider    String?
  providerRef String?
  error       String?
  metadata    Json?
  readAt      DateTime?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())
  institute   Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  notice      Notice?             @relation(fields: [noticeId], references: [id], onDelete: SetNull)
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  student     Student?            @relation(fields: [studentId], references: [id], onDelete: SetNull)
  parent      Parent?             @relation(fields: [parentId], references: [id], onDelete: SetNull)
  receipt     Receipt?            @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([instituteId, createdAt])
  @@index([noticeId])
  @@index([userId])
  @@index([studentId])
  @@index([parentId])
  @@index([type])
  @@index([channel, status])
}

model Homework {
  id            String               @id @default(cuid())
  title         String
  description   String               @db.Text
  deadline      DateTime
  marks         Int                  @default(0)
  status        HomeworkStatus       @default(DRAFT)
  externalLinks Json?
  instituteId   String
  classGroupId  String
  courseId      String?
  createdById   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  institute     Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  classGroup    ClassGroup           @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  course        Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy     User?                @relation("HomeworkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  attachments   HomeworkAttachment[]
  submissions   HomeworkSubmission[]

  @@index([instituteId, status])
  @@index([classGroupId, deadline])
  @@index([courseId])
  @@index([createdById])
}

model HomeworkAttachment {
  id         String   @id @default(cuid())
  homeworkId String
  name       String
  url        String
  type       String?
  createdAt  DateTime @default(now())
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@index([homeworkId])
}

model HomeworkSubmission {
  id            String                   @id @default(cuid())
  homeworkId    String
  studentId     String
  instituteId   String
  answerText    String?                  @db.Text
  attachmentUrl String?
  status        HomeworkSubmissionStatus @default(PENDING)
  reviewStatus  HomeworkReviewStatus?
  marksAwarded  Decimal?                 @db.Decimal(10, 2)
  feedback      String?                  @db.Text
  submittedAt   DateTime?
  reviewedAt    DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  homework      Homework                 @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student       Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institute     Institute                @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([studentId, status])
  @@index([instituteId, status])
}

model Quiz {
  id            String         @id @default(cuid())
  title         String
  description   String?        @db.Text
  instructions  String?        @db.Text
  startsAt      DateTime
  endsAt        DateTime
  timeLimitMins Int            @default(30)
  totalMarks    Decimal        @default(0) @db.Decimal(10, 2)
  passMark      Decimal        @default(0) @db.Decimal(10, 2)
  attemptLimit  Int            @default(1)
  status        QuizStatus     @default(DRAFT)
  instituteId   String
  classGroupId  String
  courseId      String?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  institute     Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  classGroup    ClassGroup     @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  course        Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("QuizCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  questions     QuizQuestion[]
  attempts      QuizAttempt[]

  @@index([instituteId, status])
  @@index([classGroupId, startsAt])
  @@index([courseId])
  @@index([createdById])
}

model QuizQuestion {
  id            String           @id @default(cuid())
  quizId        String
  type          QuizQuestionType
  prompt        String           @db.Text
  explanation   String?          @db.Text
  marks         Decimal          @default(1) @db.Decimal(10, 2)
  order         Int              @default(0)
  correctAnswer String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  quiz          Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options       QuizOption[]
  answers       QuizAnswer[]

  @@index([quizId, order])
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  label      String
  text       String
  isCorrect  Boolean      @default(false)
  order      Int          @default(0)
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    QuizAnswer[]

  @@index([questionId, order])
}

model QuizAttempt {
  id          String            @id @default(cuid())
  quizId      String
  studentId   String
  instituteId String
  attemptNo   Int               @default(1)
  status      QuizAttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime          @default(now())
  submittedAt DateTime?
  score       Decimal           @default(0) @db.Decimal(10, 2)
  autoScore   Decimal           @default(0) @db.Decimal(10, 2)
  manualScore Decimal           @default(0) @db.Decimal(10, 2)
  passed      Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  quiz        Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institute   Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@unique([quizId, studentId, attemptNo])
  @@index([studentId, status])
  @@index([instituteId, status])
}

model QuizAnswer {
  id               String       @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  answerText       String?      @db.Text
  isCorrect        Boolean?
  marksAwarded     Decimal      @default(0) @db.Decimal(10, 2)
  feedback         String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  attempt          QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   QuizOption?  @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@index([selectedOptionId])
}

model Notification {
  id          String                 @id @default(cuid())
  instituteId String
  studentId   String?
  title       String
  message     String                 @db.Text
  type        NotificationType       @default(NOTICE)
  status      NotificationReadStatus @default(UNREAD)
  actionUrl   String?
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime               @default(now())
  institute   Institute              @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student     Student?               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([instituteId, createdAt])
  @@index([studentId, status])
  @@index([type])
}

model CourseMaterial {
  id           String             @id @default(cuid())
  title        String
  description  String?            @db.Text
  type         CourseMaterialType @default(LINK)
  url          String?
  instituteId  String
  classGroupId String?
  courseId     String?
  createdById  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  institute    Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  classGroup   ClassGroup?        @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  course       Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation("CourseMaterialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([instituteId, createdAt])
  @@index([classGroupId])
  @@index([courseId])
}

model LiveClass {
  id               String                   @id @default(cuid())
  instituteId      String
  courseId         String?
  classGroupId     String
  teacherId        String?
  createdById      String?
  title            String
  description      String?                  @db.Text
  provider         LiveClassProvider
  meetingProvider  LiveClassMeetingProvider @default(OTHER_LINK)
  meetingUrl       String
  externalUrl      String?
  meetingId        String?
  joinUrl          String?
  startUrl         String?                  @db.Text
  meetingPassword  String?
  calendarEventId  String?
  providerResponse Json?
  startTime        DateTime
  endTime          DateTime
  durationMinutes  Int
  accessType       LiveClassAccessType      @default(FREE)
  price            Decimal                  @default(0) @db.Decimal(10, 2)
  status           LiveClassStatus          @default(DRAFT)
  recordingEnabled Boolean                  @default(false)
  recordingUrl     String?
  targetStudentIds Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  institute        Institute                @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  course           Course?                  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  classGroup       ClassGroup               @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  teacher          Teacher?                 @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdBy        User?                    @relation("LiveClassCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  attendances      LiveClassAttendance[]
  recordings       LiveClassRecording[]

  @@index([instituteId, status])
  @@index([classGroupId, startTime])
  @@index([courseId])
  @@index([teacherId])
  @@index([createdById])
  @@index([meetingProvider])
}

model LiveClassAttendance {
  id              String                    @id @default(cuid())
  instituteId     String
  liveClassId     String
  studentId       String
  joinedAt        DateTime                  @default(now())
  leftAt          DateTime?
  durationWatched Int?
  status          LiveClassAttendanceStatus @default(JOINED)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  institute       Institute                 @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  liveClass       LiveClass                 @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  student         Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([liveClassId, studentId])
  @@index([studentId, status])
  @@index([instituteId, joinedAt])
}

model LiveClassRecording {
  id           String              @id @default(cuid())
  instituteId  String
  liveClassId  String
  courseId     String?
  classGroupId String?
  title        String
  description  String?             @db.Text
  recordingUrl String
  accessType   LiveClassAccessType @default(FREE)
  price        Decimal             @default(0) @db.Decimal(10, 2)
  materialId   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  institute    Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  liveClass    LiveClass           @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  course       Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  classGroup   ClassGroup?         @relation(fields: [classGroupId], references: [id], onDelete: SetNull)

  @@index([instituteId, createdAt])
  @@index([liveClassId])
  @@index([courseId])
  @@index([classGroupId])
}

model IntegrationAccount {
  id                String              @id @default(cuid())
  instituteId       String
  provider          IntegrationProvider
  connected         Boolean             @default(false)
  accountEmail      String?
  externalAccountId String?
  accessToken       String?             @db.Text
  refreshToken      String?             @db.Text
  tokenExpiresAt    DateTime?
  scopes            String?             @db.Text
  metadata          Json?
  lastError         String?             @db.Text
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  institute         Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([instituteId, provider])
  @@index([provider, connected])
}

model ProviderCredential {
  id             String              @id @default(cuid())
  instituteId    String
  provider       IntegrationProvider
  name           String
  encryptedValue String              @db.Text
  lastFour       String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  institute      Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([instituteId, provider, name])
  @@index([provider])
}

model StudentDevice {
  id          String    @id @default(cuid())
  instituteId String
  studentId   String
  tokenHash   String    @unique
  deviceName  String?
  platform    String?
  pushToken   String?
  lastUsedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([instituteId])
  @@index([expiresAt])
}
