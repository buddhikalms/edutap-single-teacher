  LINK
  FILE
  VIDEO
  NOTE
}

enum LiveClassProvider {
  GOOGLE_MEET
  ZOOM
  YOUTUBE_LIVE
  JITSI
  LIVEKIT
  OTHER
}

enum LiveClassMeetingProvider {
  ZOOM_AUTO
  GOOGLE_MEET_AUTO
  EXTERNAL_ZOOM
  EXTERNAL_GOOGLE_MEET
  YOUTUBE_LIVE
  OTHER_LINK
