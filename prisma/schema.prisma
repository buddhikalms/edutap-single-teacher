enum EnrollmentPaymentMethod {
  BANK_TRANSFER
  CASH_DEPOSIT
  ONLINE_TRANSFER
  OTHER
}

enum EnrollmentPaymentSlipStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum NoticeAudience {
  INSTITUTE
  CLASS
  STUDENTS
}

enum NotificationType {
  NOTICE
  PAYMENT_DUE
  PAYMENT_OVERDUE
  ABSENT_ALERT
  CLASS_NOTICE
  RECEIPT
  ATTENDANCE_ARRIVAL
  CLASS_STARTED
  STUDENT_ARRIVED
  CLASS_ENDED
  PAYMENT_REMINDER
  HOMEWORK_ASSIGNED
  HOMEWORK_REVIEWED
  QUIZ_ASSIGNED
  LIVE_CLASS_REMINDER
  COURSE_RESOURCE_UPLOADED
  ENROLLMENT_REQUEST
  ENROLLMENT_APPROVED
  ENROLLMENT_REJECTED
