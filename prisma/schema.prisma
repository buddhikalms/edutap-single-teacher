enum CardPrintBatchItemStatus {
  PRINT_PENDING
  PRINTED
  ACTIVE
  LOST
  MISSING
  STOLEN
  DAMAGED
  REPLACED
}

model Institute {
  id                          String                       @id @default(cuid())
  name                        String
  slug                        String                       @unique
  email                       String
  phone                       String?
  address                     String?
  logoUrl                     String?
  active                      Boolean                      @default(true)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  branches                    Branch[]
  grades                      Grade[]
  subjects                    Subject[]
  users                       User[]
  students                    Student[]
  parents                     Parent[]
  teachers                    Teacher[]
  courses                     Course[]
  courseResources             CourseResource[]
  courseEnrollments           CourseEnrollment[]
  classGroups                 ClassGroup[]
  payments                    Payment[]
  receipts                    Receipt[]
  auditLogs                   AttendanceAuditLog[]
  notices                     Notice[]
  notifications               NotificationLog[]
  settings                    InstituteSettings?
  subscription                InstituteSubscription?
  homework                    Homework[]
  homeworkSubmissions         HomeworkSubmission[]
  quizzes                     Quiz[]
  quizAttempts                QuizAttempt[]
  notificationsV2             Notification[]
  webPushSubscriptions        WebPushSubscription[]
  courseMaterials             CourseMaterial[]
  studentDevices              StudentDevice[]
  liveClasses                 LiveClass[]
  liveClassAttendances        LiveClassAttendance[]
  liveClassRecordings         LiveClassRecording[]
  integrationAccounts         IntegrationAccount[]
  providerCredentials         ProviderCredential[]
  attendanceNotificationLogs  AttendanceNotificationLog[]
  classEndNotificationLogs    ClassEndNotificationLog[]
  teacherRegistrationRequests TeacherRegistrationRequest[]
  studentCards                StudentCard[]
  studentCardHistory          StudentCardHistory[]
  cardScanLogs                CardScanLog[]
  cardPrintBatches            CardPrintBatch[]
  cardPrintBatchItems         CardPrintBatchItem[]
  enrollmentRequests          EnrollmentRequest[]
}

model InstituteSettings {
  id                                         String    @id @default(cuid())
  instituteId                                String    @unique
  receiptPrefix                              String    @default("RCT")
  receiptFooter                              String?   @db.Text
  paymentDueDay                              Int       @default(10)
  attendanceLateAfterMins                    Int       @default(15)
  attendanceAutoAbsent                       Boolean   @default(false)
  currency                                   String    @default("USD")
  themeColor                                 String    @default("#0f766e")
  logoPlaceholder                            String?
  attendanceParentArrivalNotificationEnabled Boolean   @default(true)
  attendanceParentIncludePaymentSummary      Boolean   @default(true)
  attendanceParentIncludeOverdueAmount       Boolean   @default(true)
  attendanceParentSendOncePerSession         Boolean   @default(true)
  attendanceParentSendOnPresent              Boolean   @default(true)
  attendanceParentSendOnLate                 Boolean   @default(true)
  attendanceParentMessageTemplate            String?   @db.Text
  classEndedNotificationEnabled              Boolean   @default(true)
  classEndedIncludePaymentSummary            Boolean   @default(true)
  classEndedSendToPresent                    Boolean   @default(true)
  classEndedSendToLate                       Boolean   @default(true)
  classEndedSendToAbsent                     Boolean   @default(false)
  classEndedMessageTemplate                  String?   @db.Text
  notificationMobilePushEnabled              Boolean   @default(true)
  notificationWebPushEnabled                 Boolean   @default(true)
  notificationInAppEnabled                   Boolean   @default(true)
  notificationIncludeDueDates                Boolean   @default(true)
  cardRequireDuringRegistration              Boolean   @default(false)
  cardRequireBothNfcAndQr                    Boolean   @default(false)
  cardAllowQrOnly                            Boolean   @default(true)
  cardAllowNfcOnly                           Boolean   @default(true)
  cardAutoGenerateQrToken                    Boolean   @default(true)
  cardReplacementFee                         Decimal?  @db.Decimal(10, 2)
  cardNotifyParentOnReplacement              Boolean   @default(false)
  cardNotifyAdminOnLostOrStolenScan          Boolean   @default(true)
  notificationCustomTemplates                Json?
  branchSettings                             Json?
  createdAt                                  DateTime  @default(now())
  updatedAt                                  DateTime  @updatedAt
  institute                                  Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
}

model InstituteSubscription {
  id                       String              @id @default(cuid())
  instituteId              String              @unique
  plan                     SubscriptionPlanKey @default(INSTITUTE_STARTER)
  planId                   String?
  status                   SubscriptionStatus  @default(TRIAL)
  startedAt                DateTime            @default(now())
  currentPeriodEnd         DateTime?
  monthlyPrice             Decimal             @default(79) @db.Decimal(10, 2)
  yearlyPrice              Decimal?            @db.Decimal(10, 2)
  studentLimit             Int
  teacherLimit             Int
  branchLimit              Int
  classLimit               Int                 @default(30)
  courseLimit              Int                 @default(20)
  storageLimitMb           Int                 @default(1024)
  smsCredits               Int
  liveClassAccess          Boolean             @default(false)
  parentNotificationAccess Boolean             @default(false)
  customBrandingAccess     Boolean             @default(false)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  institute                Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  planRecord               SubscriptionPlan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([plan])
  @@index([planId])
  @@index([status])
}

model SubscriptionPlan {
  id                       String                  @id @default(cuid())
  code                     SubscriptionPlanKey     @unique
  slug                     String                  @unique
  name                     String
  description              String                  @db.Text
  monthlyPrice             Decimal?                @db.Decimal(10, 2)
  yearlyPrice              Decimal?                @db.Decimal(10, 2)
  recommended              Boolean                 @default(false)
  maxTeachers              Int?
  maxStudents              Int?
  maxBranches              Int?
  maxClasses               Int?
  maxCourses               Int?
  storageLimitMb           Int?
  liveClassAccess          Boolean                 @default(false)
  parentNotificationAccess Boolean                 @default(false)
  customBrandingAccess     Boolean                 @default(false)
  isActive                 Boolean                 @default(true)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  features                 PackageFeature[]
  usageLimits              UsageLimit[]
  subscriptions            InstituteSubscription[]
}

model UsageLimit {
  id        String           @id @default(cuid())
  planId    String
  key       String
  label     String
  limit     Int?
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([key])
}

model PackageFeature {
  id        String           @id @default(cuid())
  planId    String
  label     String
  included  Boolean          @default(true)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sortOrder])
}

model Branch {
  id                 String              @id @default(cuid())
  name               String
  code               String
  location           String?
  address            String?
  phone              String?
  isActive           Boolean             @default(true)
  instituteId        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  institute          Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  users              User[]
  students           Student[]
  teachers           Teacher[]
  classGroups        ClassGroup[]
  attendanceSessions AttendanceSession[]

  @@unique([instituteId, code])
  @@index([instituteId])
}

model Grade {
  id                 String              @id @default(cuid())
  instituteId        String
  name               String
  order              Int                 @default(0)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  institute          Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  courses            Course[]
  classGroups        ClassGroup[]
  enrollmentRequests EnrollmentRequest[]

  @@unique([instituteId, name])
  @@index([instituteId, order])
}

model Subject {
  id                 String              @id @default(cuid())
  instituteId        String
  name               String
  description        String?             @db.Text
  color              String              @default("#0f766e")
  icon               String              @default("BookOpen")
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  institute          Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  classGroups        ClassGroup[]
  courses            Course[]
  homework           Homework[]
  quizzes            Quiz[]
  enrollmentRequests EnrollmentRequest[]

  @@unique([instituteId, name])
  @@index([instituteId, isActive])
}

model User {
  id                        String                  @id @default(cuid())
  name                      String
  email                     String?                 @unique
  mobile                    String?                 @unique
  googleId                  String?                 @unique
  passwordHash              String?
  authProvider              AuthProvider            @default(PASSWORD)
  role                      UserRole                @default(STAFF)
  image                     String?
  emailVerified             DateTime?
  mustChangePassword        Boolean                 @default(false)
  accountStatus             UserAccountStatus       @default(ACTIVE)
  instituteId               String?
  branchId                  String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  institute                 Institute?              @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  branch                    Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  teacher                   Teacher?
  parent                    Parent?
  student                   Student?
  mobileTokens              MobileAuthToken[]
  mobileDevices             StudentDevice[]
  noticesCreated            Notice[]
  notifications             NotificationLog[]
  notificationsV2           Notification[]
  webPushSubscriptions      WebPushSubscription[]
  homeworkCreated           Homework[]              @relation("HomeworkCreatedBy")
  quizzesCreated            Quiz[]                  @relation("QuizCreatedBy")
  courseMaterialsCreated    CourseMaterial[]        @relation("CourseMaterialCreatedBy")
  liveClassesCreated        LiveClass[]             @relation("LiveClassCreatedBy")
  zoomConnection            ZoomConnection?
  zoomMeetingSettings       ZoomMeetingSettings?
  zoomMeetings              ZoomMeeting[]
  studentCardsIssued        StudentCard[]           @relation("StudentCardIssuedBy")
  studentCardsReplaced      StudentCard[]           @relation("StudentCardReplacedBy")
  studentCardHistory        StudentCardHistory[]    @relation("StudentCardHistoryPerformedBy")
  cardPrintBatchesExported  CardPrintBatch[]        @relation("CardPrintBatchExportedBy")
  cardScanLogs              CardScanLog[]           @relation("CardScanLogScannedBy")
  studentEnrollmentRequests EnrollmentRequest[]     @relation("EnrollmentRequestStudentUser")
  parentEnrollmentRequests  EnrollmentRequest[]     @relation("EnrollmentRequestParentUser")
  familyStudents            Student[]               @relation("FamilyStudents")
  familyEnrollmentRequests  EnrollmentRequest[]     @relation("EnrollmentRequestFamilyUser")
  enrollmentPaymentSlips    EnrollmentPaymentSlip[]

  @@index([instituteId])
  @@index([branchId])
}

model MobileAuthToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Student {
  id                          String                      @id @default(cuid())
  admissionNo                 String
  firstName                   String
  lastName                    String
  email                       String?
  phone                       String?
  dateOfBirth                 DateTime?
  status                      StudentStatus               @default(ACTIVE)
  avatarUrl                   String?
  nfcUid                      String?
  qrCode                      String?
  attendanceToken             String?                     @default(cuid())
  userId                      String?                     @unique
  familyUserId                String?
  instituteId                 String
  branchId                    String
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  institute                   Institute                   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch                      Branch                      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user                        User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  familyUser                  User?                       @relation("FamilyStudents", fields: [familyUserId], references: [id], onDelete: SetNull)
  parents                     Parent[]
  parentLinks                 ParentStudent[]
  enrollments                 Enrollment[]
  attendance                  AttendanceRecord[]
  attendanceNotificationLogs  AttendanceNotificationLog[]
  classEndNotificationLogs    ClassEndNotificationLog[]
  payments                    Payment[]
  auditLogs                   AttendanceAuditLog[]
  noticeRecipients            NoticeRecipient[]
  notifications               NotificationLog[]
  homeworkSubmissions         HomeworkSubmission[]
  quizAttempts                QuizAttempt[]
  notificationsV2             Notification[]
  devices                     StudentDevice[]
  liveClassAttendances        LiveClassAttendance[]
  courseEnrollments           CourseEnrollment[]
  cards                       StudentCard[]
  cardHistory                 StudentCardHistory[]
  cardScanLogs                CardScanLog[]
  cardPrintBatchItems         CardPrintBatchItem[]
  convertedEnrollmentRequests EnrollmentRequest[]         @relation("ConvertedEnrollmentStudent")
  requestedEnrollment         EnrollmentRequest?          @relation("RequestedEnrollmentStudent")
  enrollmentPaymentSlips      EnrollmentPaymentSlip[]

  @@unique([instituteId, admissionNo])
  @@index([instituteId, nfcUid])
  @@index([instituteId, qrCode])
  @@index([attendanceToken])
  @@index([branchId])
  @@index([familyUserId])
}

model Parent {
  id                         String                      @id @default(cuid())
  name                       String
  email                      String?
  phone                      String
  relationship               String?                     @default("Guardian")
  nic                        String?
  address                    String?                     @db.Text
  appLoginIdentifier         String?
  emergencyContactNumber     String?
  occupation                 String?
  userId                     String?                     @unique
  instituteId                String
  status                     UserAccountStatus           @default(ACTIVE)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  institute                  Institute                   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user                       User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  students                   Student[]
  studentLinks               ParentStudent[]
  devices                    StudentDevice[]
  noticeRecipients           NoticeRecipient[]
  notifications              NotificationLog[]
  notificationsV2            Notification[]
  webPushSubscriptions       WebPushSubscription[]
  attendanceNotificationLogs AttendanceNotificationLog[]
  classEndNotificationLogs   ClassEndNotificationLog[]
  requestedEnrollment        EnrollmentRequest?          @relation("RequestedEnrollmentParent")

  @@index([instituteId])
}

model WebPushSubscription {
  id           String    @id @default(cuid())
  instituteId  String
  userId       String
  parentId     String?
  endpoint     String    @db.Text
  endpointHash String    @unique
  p256dh       String    @db.Text
  auth         String    @db.Text
  userAgent    String?   @db.Text
  platform     String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  institute    Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Parent?   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([userId])
  @@index([parentId])
  @@index([isActive])
}

model ParentStudent {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  relation  String?
  createdAt DateTime @default(now())
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

model Teacher {
  id             String       @id @default(cuid())
  name           String
  email          String
  phone          String?
  specialty      String?
  photoUrl       String?
  bio            String?      @db.Text
  subjects       Json?
  gradesTaught   Json?
  experience     String?
  qualifications String?      @db.Text
  teachingMode   TeachingMode @default(BOTH)
  userId         String?      @unique
  instituteId    String
  branchId       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  institute      Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  courses        Course[]
  classGroups    ClassGroup[]
  liveClasses    LiveClass[]

  @@unique([instituteId, email])
  @@index([branchId])
}

model Course {
  id             String               @id @default(cuid())
  name           String
  slug           String?
  code           String
  subject        String?
  subjectId      String?
  category       String?
  grade          String?
  gradeId        String?
  teacherId      String?
  description    String?
  thumbnailUrl   String?
  durationType   CourseDurationType   @default(MONTHS)
  durationValue  Int?
  startDate      DateTime?
  endDate        DateTime?
  isFree         Boolean              @default(false)
  fee            Decimal              @db.Decimal(10, 2)
  accessType     CourseAccessType     @default(PAID)
  status         CourseStatus         @default(PUBLISHED)
  instituteId    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  institute      Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  gradeLevel     Grade?               @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  subjectRecord  Subject?             @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher        Teacher?             @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  modules        CourseModule[]
  homework       Homework[]
  quizzes        Quiz[]
  materials      CourseMaterial[]
  liveClasses    LiveClass[]
  liveRecordings LiveClassRecording[]
  resources      CourseResource[]
  enrollments    CourseEnrollment[]
  payments       Payment[]

  @@unique([instituteId, code])
  @@unique([instituteId, slug])
  @@index([instituteId])
  @@index([gradeId])
  @@index([subjectId])
  @@index([teacherId])
}

model CourseModule {
  id            String           @id @default(cuid())
  courseId      String
  title         String
  description   String?          @db.Text
  sortOrder     Int              @default(0)
  isFreePreview Boolean          @default(false)
  isLocked      Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resources     CourseResource[]
  quizzes       Quiz[]

  @@index([courseId, sortOrder])
}

model CourseResource {
