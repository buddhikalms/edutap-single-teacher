  INSTITUTE_ADMIN
  BRANCH_ADMIN
  TEACHER
  STAFF
  STUDENT
  PARENT
  FAMILY
}

enum UserAccountStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  BOTH
}

enum StudentStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  PAUSED
  GRADUATED
  ARCHIVED
}

enum AttendanceStatus {
