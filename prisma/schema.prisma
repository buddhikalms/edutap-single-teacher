  MONTHLY_FEE
  COURSE_PAYMENT
  ADMISSION_FEE
  EXAM_FEE
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  OTHER
