model QuizQuestion {
  id            String           @id @default(cuid())
  quizId        String
  type          QuizQuestionType
  prompt        String           @db.Text
  explanation   String?          @db.Text
  marks         Decimal          @default(1) @db.Decimal(10, 2)
  order         Int              @default(0)
  correctAnswer String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  quiz          Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options       QuizOption[]
  answers       QuizAnswer[]

  @@index([quizId, order])
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  label      String
  text       String
  isCorrect  Boolean      @default(false)
  order      Int          @default(0)
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    QuizAnswer[]

  @@index([questionId, order])
}

model QuizAttempt {
  id          String            @id @default(cuid())
  quizId      String
  studentId   String
  instituteId String
  attemptNo   Int               @default(1)
  status      QuizAttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime          @default(now())
  submittedAt DateTime?
  score       Decimal           @default(0) @db.Decimal(10, 2)
  autoScore   Decimal           @default(0) @db.Decimal(10, 2)
  manualScore Decimal           @default(0) @db.Decimal(10, 2)
  passed      Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  quiz        Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institute   Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@unique([quizId, studentId, attemptNo])
  @@index([studentId, status])
  @@index([instituteId, status])
}

model QuizAnswer {
  id               String       @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  answerText       String?      @db.Text
  isCorrect        Boolean?
  marksAwarded     Decimal      @default(0) @db.Decimal(10, 2)
  feedback         String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  attempt          QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   QuizOption?  @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@index([selectedOptionId])
}

model Notification {
  id                         String                      @id @default(cuid())
  instituteId                String
  userId                     String?
  studentId                  String?
  parentId                   String?
  title                      String
  body                       String?                     @db.Text
  message                    String                      @db.Text
  type                       NotificationType            @default(NOTICE)
  status                     NotificationReadStatus      @default(UNREAD)
  actionUrl                  String?
  dataJson                   Json?
  metadata                   Json?
  readAt                     DateTime?
  createdAt                  DateTime                    @default(now())
  institute                  Institute                   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user                       User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  student                    Student?                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent                     Parent?                     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  deliveryLogs               NotificationLog[]
  attendanceNotificationLogs AttendanceNotificationLog[]
  classEndNotificationLogs   ClassEndNotificationLog[]

  @@index([instituteId, createdAt])
  @@index([userId, status])
  @@index([studentId, status])
  @@index([parentId, status])
  @@index([type])
}

model CourseMaterial {
  id           String             @id @default(cuid())
  title        String
  description  String?            @db.Text
  type         CourseMaterialType @default(LINK)
  url          String?
  instituteId  String
  classGroupId String?
  courseId     String?
  createdById  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  institute    Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  classGroup   ClassGroup?        @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  course       Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation("CourseMaterialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([instituteId, createdAt])
  @@index([classGroupId])
  @@index([courseId])
}

model LiveClass {
  id               String                   @id @default(cuid())
  instituteId      String
  courseId         String?
  classGroupId     String
  teacherId        String?
  createdById      String?
  title            String
  description      String?                  @db.Text
  provider         LiveClassProvider
  meetingProvider  LiveClassMeetingProvider @default(OTHER_LINK)
  meetingUrl       String
  externalUrl      String?
  meetingId        String?
  joinUrl          String?
  startUrl         String?                  @db.Text
  meetingPassword  String?
  calendarEventId  String?
  providerResponse Json?
  startTime        DateTime
  endTime          DateTime
  durationMinutes  Int
  accessType       LiveClassAccessType      @default(FREE)
  price            Decimal                  @default(0) @db.Decimal(10, 2)
  status           LiveClassStatus          @default(DRAFT)
  recordingEnabled Boolean                  @default(false)
  recordingUrl     String?
  targetStudentIds Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  institute        Institute                @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  course           Course?                  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  classGroup       ClassGroup               @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  teacher          Teacher?                 @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdBy        User?                    @relation("LiveClassCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  attendances      LiveClassAttendance[]
  recordings       LiveClassRecording[]
  zoomMeeting      ZoomMeeting?

  @@index([instituteId, status])
  @@index([classGroupId, startTime])
  @@index([courseId])
  @@index([teacherId])
  @@index([createdById])
  @@index([meetingProvider])
}

model LiveClassAttendance {
  id              String                    @id @default(cuid())
  instituteId     String
  liveClassId     String
  studentId       String
  joinedAt        DateTime                  @default(now())
  leftAt          DateTime?
  durationWatched Int?
  status          LiveClassAttendanceStatus @default(JOINED)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  institute       Institute                 @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  liveClass       LiveClass                 @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  student         Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([liveClassId, studentId])
  @@index([studentId, status])
  @@index([instituteId, joinedAt])
}

model LiveClassRecording {
  id           String              @id @default(cuid())
  instituteId  String
  liveClassId  String
  courseId     String?
  classGroupId String?
  title        String
  description  String?             @db.Text
  recordingUrl String
  accessType   LiveClassAccessType @default(FREE)
  price        Decimal             @default(0) @db.Decimal(10, 2)
  materialId   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  institute    Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  liveClass    LiveClass           @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  course       Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  classGroup   ClassGroup?         @relation(fields: [classGroupId], references: [id], onDelete: SetNull)

  @@index([instituteId, createdAt])
  @@index([liveClassId])
  @@index([courseId])
  @@index([classGroupId])
}

model ZoomConnection {
  id            String    @id @default(cuid())
  userId        String    @unique
  zoomAccountId String
  email         String
  displayName   String?
  accessToken   String    @db.Text
  refreshToken  String    @db.Text
  expiresAt     DateTime
  connectedAt   DateTime  @default(now())
  lastSyncAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetings      ZoomMeeting[]

  @@index([zoomAccountId])
  @@index([email])
  @@index([expiresAt])
}

model ZoomMeetingSettings {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  defaultDurationMinutes     Int      @default(60)
  defaultWaitingRoom         Boolean  @default(true)
  defaultRecording           String   @default("none")
  defaultJoinBeforeHost      Boolean  @default(false)
  defaultMuteParticipants    Boolean  @default(true)
  defaultPasscodeGeneration  Boolean  @default(true)
  defaultHostVideo           Boolean  @default(true)
  defaultParticipantVideo    Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ZoomMeeting {
  id                String      @id @default(cuid())
  userId            String
  classGroupId      String
  liveClassId       String      @unique
  zoomConnectionId  String?
  zoomMeetingId     String
  topic             String
  joinUrl           String      @db.Text
  startUrl          String?     @db.Text
  password          String?
  status            String      @default("scheduled")
  scheduledTime     DateTime?
  durationMinutes   Int?
  recordingImported Boolean     @default(false)
  recordingUrl      String?     @db.Text
  recordingMetadata Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  classGroup        ClassGroup  @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  liveClass         LiveClass   @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  zoomConnection    ZoomConnection? @relation(fields: [zoomConnectionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([classGroupId])
  @@index([zoomMeetingId])
  @@index([status])
}

model IntegrationAccount {
  id                String              @id @default(cuid())
  instituteId       String
  provider          IntegrationProvider
  connected         Boolean             @default(false)
  accountEmail      String?
  externalAccountId String?
  accessToken       String?             @db.Text
  refreshToken      String?             @db.Text
  tokenExpiresAt    DateTime?
  scopes            String?             @db.Text
  metadata          Json?
  lastError         String?             @db.Text
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  institute         Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([instituteId, provider])
  @@index([provider, connected])
}

model ProviderCredential {
  id             String              @id @default(cuid())
  instituteId    String
  provider       IntegrationProvider
  name           String
  encryptedValue String              @db.Text
  lastFour       String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  institute      Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([instituteId, provider, name])
  @@index([provider])
}

model StudentDevice {
  id            String    @id @default(cuid())
  instituteId   String
  studentId     String?
  parentId      String?
  userId        String?
  tokenHash     String?   @unique
  deviceName    String?
  platform      String?
  pushToken     String?
  expoPushToken String?
  isActive      Boolean   @default(true)
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  institute     Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student       Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent        Parent?   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([parentId])
  @@index([userId])
  @@index([instituteId])
  @@index([expiresAt])
  @@index([expoPushToken])
}

model AttendanceNotificationLog {
  id                  String            @id @default(cuid())
  instituteId         String
  attendanceSessionId String
  attendanceRecordId  String
  studentId           String
  parentId            String
  notificationId      String
  sentAt              DateTime          @default(now())
  institute           Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  attendanceRecord    AttendanceRecord  @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent              Parent            @relation(fields: [parentId], references: [id], onDelete: Cascade)
  notification        Notification      @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([attendanceRecordId, parentId])
  @@index([instituteId, sentAt])
  @@index([attendanceSessionId, studentId])
  @@index([parentId])
}

model ClassEndNotificationLog {
  id                  String            @id @default(cuid())
  instituteId         String
  attendanceSessionId String
  classGroupId        String
  studentId           String
  parentId            String
  notificationId      String
  sentAt              DateTime          @default(now())
  createdAt           DateTime          @default(now())
  institute           Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  classGroup          ClassGroup        @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent              Parent            @relation(fields: [parentId], references: [id], onDelete: Cascade)
  notification        Notification      @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([attendanceSessionId, studentId, parentId])
  @@index([instituteId, sentAt])
  @@index([classGroupId])
  @@index([parentId])
}
