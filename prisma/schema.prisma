  FREE
  PAID
}

enum LiveClassStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum LiveClassAttendanceStatus {
  JOINED
  LEFT
}

enum IntegrationProvider {
