enum NotificationChannel {
  IN_APP
  PUSH
  MOBILE_PUSH
  WEB_PUSH
  SMS
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

enum SubscriptionPlanKey {
  SINGLE_TEACHER
  INSTITUTE_STARTER
  INSTITUTE_PRO
  ENTERPRISE
  TEACHER
  SMALL_INSTITUTE
  PREMIUM_INSTITUTE
}

enum SubscriptionStatus {
