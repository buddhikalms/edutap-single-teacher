# Public image, homework, and course-resource upload storage.
# Leave empty to use public/uploads in local development.
# On a server, set this to a persistent writable absolute path, for example:
# EDUTAP_UPLOAD_DIR="/var/www/edutap/uploads"
EDUTAP_UPLOAD_DIR=""

# Private enrollment payment slip storage. Files are served only through an authorized API.
PAYMENT_SLIP_MAX_MB="5"
NEXT_PUBLIC_PAYMENT_SLIP_MAX_MB="5"
PAYMENT_SLIP_STORAGE_DIR=".private/payment-slips"

# Optional fallback OAuth client values for Google Meet auto creation.
# Institutes can also save these encrypted from /live-classes/settings.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"
# Add http://localhost:3000/api/auth/callback/google as an authorized
# redirect URI in Google Cloud for EduTap Account login/signup.

# Zoom OAuth app credentials. Teachers connect their own Zoom accounts from
# /dashboard/settings/live-classes; these values stay server-side only.
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_REDIRECT_URI="http://localhost:3000/api/integrations/zoom/callback"
# Required for profile lookup, meeting creation, and recording import.
ZOOM_OAUTH_SCOPES="user:read:user meeting:write:meeting recording:read"

# High-traffic NFC/QR attendance.
# Add connection_limit/pool_timeout to DATABASE_URL in production, for example:
# mysql://user:password@host:3306/edutap?connection_limit=20&pool_timeout=20
REDIS_URL=""
BULLMQ_REDIS_URL=""
NOTIFICATION_QUEUE_CONCURRENCY="10"
NOTIFICATION_QUEUE_POLL_MS="5000"
NOTIFICATION_QUEUE_INLINE="true"
ATTENDANCE_SMS_ENABLED="false"
SMSLENZ_USER_ID=""
SMSLENZ_API_KEY=""
SMSLENZ_SENDER_ID=""
SMSLENZ_API_URL="https://smslenz.lk/api/send-sms"
SMSLENZ_TIMEOUT_MS="15000"
ATTENDANCE_RATE_LIMIT_DEVICE_PER_SECOND="10"
ATTENDANCE_RATE_LIMIT_DEVICE_WINDOW_MS="1000"
ATTENDANCE_RATE_LIMIT_IP_PER_SECOND="30"
ATTENDANCE_RATE_LIMIT_IP_WINDOW_MS="1000"
ATTENDANCE_RATE_LIMIT_CARD_DUPLICATE_LIMIT="3"
ATTENDANCE_RATE_LIMIT_CARD_DUPLICATE_WINDOW_MS="10000"

# Fingerprint machine attendance. Use this key from device bridge software.
FINGERPRINT_ATTENDANCE_API_KEY=""
FINGERPRINT_ATTENDANCE_RATE_LIMIT_PER_MINUTE="120"

# Face-recognition attendance. Keep the Python service private to the app network.
FACE_ATTENDANCE_ENABLED="false"
FACE_SERVICE_INTERNAL_URL="http://face-service:8000"
FACE_SERVICE_URL="http://face-service:8000"
FACE_SERVICE_API_KEY=""
FACE_SERVICE_TOKEN=""
FACE_SERVICE_TIMEOUT_MS="15000"
FACE_EMBEDDING_ENCRYPTION_KEY=""
BIOMETRIC_ENCRYPTION_KEY=""
FACE_ENCRYPTION_KEY_VERSION="v1"
FACE_MATCH_THRESHOLD="0.82"
FACE_AMBIGUITY_MARGIN="0.10"
FACE_MANUAL_REVIEW_THRESHOLD="0.72"
FACE_LIVENESS_THRESHOLD="0.85"
FACE_SCAN_COOLDOWN_MS="3500"
NEXT_PUBLIC_FACE_SCAN_COOLDOWN_MS="3500"
FACE_MAX_ATTEMPTS="3"
FACE_ATTEMPT_COOLDOWN_SECONDS="30"
ATTENDANCE_LATE_GRACE_MINUTES="15"
FACE_VERIFICATION_TOKEN_SECRET=""
