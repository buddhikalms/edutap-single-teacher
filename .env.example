DATABASE_URL="mysql://root:password@localhost:3306/edutapsingleteacher"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-at-least-32-random-bytes"
PROVIDER_CREDENTIAL_KEY="replace-with-at-least-32-random-bytes"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@edutap.com"

# Public image, homework, and course-resource upload storage.
# Leave empty to use public/uploads in local development.
# On a server, set this to a persistent writable absolute path, for example:
# EDUTAP_UPLOAD_DIR="/var/www/edutap/uploads"
EDUTAP_UPLOAD_DIR=""

# Private enrollment payment slip storage. Files are served only through an authorized API.
PAYMENT_SLIP_MAX_MB="5"
NEXT_PUBLIC_PAYMENT_SLIP_MAX_MB="5"
PAYMENT_SLIP_STORAGE_DIR=".private/payment-slips"

# Optional fallback OAuth client values for Google Meet auto creation.
# Institutes can also save these encrypted from /live-classes/settings.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"
# Add http://localhost:3000/api/auth/callback/google as an authorized
# redirect URI in Google Cloud for EduTap Account login/signup.

# Zoom OAuth app credentials. Teachers connect their own Zoom accounts from
# /dashboard/settings/live-classes; these values stay server-side only.
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_REDIRECT_URI="http://localhost:3000/api/integrations/zoom/callback"
# Required for profile lookup, meeting creation, and recording import.
ZOOM_OAUTH_SCOPES="user:read:user meeting:write:meeting recording:read"

# Demo login after seeding:
# Email: admin@edutap.test
# Password: EduTap@2026
